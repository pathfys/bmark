# ── Telegram API (my.telegram.org) ──
API_ID=
API_HASH=

# Userbot session name(s). One is enough for see.tg mode.
# Copy the authorized .session file to the server to skip re-login.
SESSION_NAMES=gift_tracker

# ── Bot (from @BotFather). Must be ADMIN in the branch supergroup. ──
BOT_TOKEN=
# Optional; auto-detected from the bot if left empty.
BOT_USERNAME=

# ── Owner data source ──
OWNER_SOURCE=kartoshka
KARTOSHKA_TOKEN=
# /who = paid owner lookup (0.01 TON/req). Cached, so one charge per gift.
KARTOSHKA_GIFT_PATH=/v1/gift/{slug}/who

# Only post lots whose seller has a public @username (button opens a chat).
REQUIRE_USERNAME=1

# ── Branches = forum topics in ONE supergroup (t.me/c/<id>/<topic>) ──
BRANCH_CHAT_ID=-1003940557866
TOPIC_ALL=5
TOPIC_RICH=3
TOPIC_POOR=4
TOPIC_BLACK=6
RICH_MIN_STARS=2000
POOR_MAX_STARS=500
BLACK_COLLECTIONS=

# ── Filters (save /who money by narrowing what gets resolved) ──
# Post only expensive gifts: set a floor here.
MIN_PRICE_STARS=0
MAX_PRICE_STARS=0
# Comma-separated collection titles to track (empty = all 151).
TRACK_COLLECTIONS=
MAX_SELLER_LEVEL=0
MAX_SELLER_NFT_COUNT=0

# ── Posting speed ──
POSTS_PER_MIN=40
POLL_INTERVAL=30

# ── Claim gating ──
REQUIRE_START=1
CLAIM_MAX_PER_WINDOW=10
CLAIM_WINDOW_SEC=30

# ── Owner cache (one paid lookup per gift) ──
OWNER_CACHE_TTL=0
OWNER_CACHE_NEG_TTL=21600

DB_PATH=gifts.db

# ── Local gift DB feed (owners.db from gift_parser_bot) ──
# Mix lots from a local SQLite DB with live market lots by COUNT, alternating.
# Default: 8 DB lots : 2 market lots, repeating.
GIFTDB_ENABLED=1
GIFTDB_PATH=owners.db
GIFTDB_RATIO_DB=8
GIFTDB_RATIO_MARKET=2
# How many rows to pull per DB batch, idle wait when the DB is drained.
GIFTDB_BATCH=200
GIFTDB_IDLE_SLEEP=10
# desc = newest listings first (by posted_at); asc = oldest first.
GIFTDB_ORDER=desc
# Only feed DB lots whose seller has a public @username (same gate as market).
GIFTDB_REQUIRE_USERNAME=1
