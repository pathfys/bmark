# Telegram MTProto credentials
# Получи на https://my.telegram.org → API Development Tools
API_ID=12345678
API_HASH=your_api_hash_here

# Имя файла сессии Telethon (без расширения)
SESSION_NAME=gift_tracker

# Интервал опроса маркета в секундах
POLL_INTERVAL=30

# Лимит подарков за один запрос к API
MAX_GIFTS_PER_PAGE=50

# Путь к SQLite базе данных
DB_PATH=tracker/gifts.db

# ID чата/канала для уведомлений (опционально)
# Формат: -100XXXXXXXXXX (канал/супергруппа) или числовой user_id
# NOTIFY_CHAT_ID=-1001234567890

# Фильтр коллекций (через запятую, пусто = все)
# TRACK_COLLECTIONS=Lunar Snake,Heart Crown

# Фильтр по цене в Stars (0 = без ограничения)
MIN_PRICE_STARS=0
MAX_PRICE_STARS=0
