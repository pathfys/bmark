# Telegram MTProto credentials
# Получи на https://my.telegram.org → API Development Tools
API_ID=12345678
API_HASH=your_api_hash_here

# Имя файла сессии Telethon (без расширения)
SESSION_NAME=gift_tracker

# ── Telegram Bot ──
# Создай бота через @BotFather
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# ── Группа для логов ──
# ID супергруппы куда бот шлёт листинги с кнопками
# Формат: -100XXXXXXXXXX
LOG_GROUP_ID=-1001234567890

# ── Интервал опроса ──
POLL_INTERVAL=30

# Лимит подарков за один запрос к API
MAX_GIFTS_PER_PAGE=50

# Путь к SQLite базе данных
DB_PATH=tracker/gifts.db

# ── Фильтры продавца ──
# Макс. уровень профиля Telegram (0 = без ограничения)
MAX_SELLER_LEVEL=10
# Макс. количество NFT подарков на профиле (0 = без ограничения)
MAX_SELLER_NFT_COUNT=10

# ── Фильтр коллекций ──
# Через запятую, пусто = все
# TRACK_COLLECTIONS=Lunar Snake,Heart Crown

# Фильтр по цене в Stars (0 = без ограничения)
MIN_PRICE_STARS=0
MAX_PRICE_STARS=0

# ── Шаблон DM при «Занять лот» ──
# Переменные: {title}, {num}, {price}, {link}
# CLAIM_DM_TEMPLATE=Привет! Хочу приобрести ваш подарок «{title}» #{num} за {price} ⭐\nСсылка: {link}

# ── Кэш проверок профилей (секунды) ──
SELLER_CACHE_TTL=300
